# Leave DATABASE_URL blank to use data/easyoats.db (SQLite).
DATABASE_URL=
# For PostgreSQL later: postgresql+psycopg://user:password@localhost/easyoats
EXCEL_PATH=EasyOats_Order_Tracker.xlsx
BACKUP_DIR=backups
TEMPLATE_PATH=templates/EasyOats_Order_Tracker.xlsx
# Hosted mode uses verified Google/Microsoft OIDC identities.
AUTH_REQUIRED=false
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SERVER_METADATA_URL=https://accounts.google.com/.well-known/openid-configuration
OIDC_REDIRECT_URI=http://localhost:8501/oauth2callback
AUTH_COOKIE_SECRET=
# Comma-separated emails. Keep at least one bootstrap administrator for recovery.
BOOTSTRAP_ADMIN_EMAILS=
BOOTSTRAP_STAFF_EMAILS=
# Optional local-only fallback for administrator stock overrides.
# Hosted mode uses the authenticated admin role. Never commit your real .env file.
ADMIN_PIN=
